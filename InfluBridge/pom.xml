<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>fr.influencraft</groupId>
    <artifactId>InfluBridge</artifactId>
    <version>26.2</version>
    <packaging>jar</packaging>

    <name>InfluBridge</name>

    <properties>
        <!-- API Paper de compilation : 26.2 = version du serveur. Les jars compiles contre 26.2
             restent compatibles 26.3 (mvn -P paper-26.3 pour le verifier) -->
        <paper.api.version>26.2.build.124-stable</paper.api.version>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <repositories>
        <repository>
            <id>papermc</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
        </repository>
        <repository>
            <id>placeholderapi</id>
            <url>https://repo.extendedclip.com/content/repositories/placeholderapi/</url>
        </repository>
    </repositories>

    <dependencies>
        <!-- PlaceholderAPI (soft dependency, installé sur le serveur : PlaceholderAPI-2.12.2.jar) -->
        <dependency>
            <groupId>me.clip</groupId>
            <artifactId>placeholderapi</artifactId>
            <version>2.11.6</version>
            <scope>provided</scope>
        </dependency>

        <!-- Paper API (provided by the server at runtime).
             Le serveur tourne en Paper 26.2 depuis la bêta 0.2 (cf. logs/latest.log "This server
             is running Paper version 26.2-124-ver/... (Implementing API version
             26.2.build.124-stable)") — version alignée sur cette build. -->
        <dependency>
            <groupId>io.papermc.paper</groupId>
            <artifactId>paper-api</artifactId>
            <version>${paper.api.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- Netty (bundlé par Paper au runtime, jamais chargé depuis Maven côté serveur) —
             version exacte pinnée pour Paper 26.2 (cf. META-INF/libraries.list du paper.jar serveur).
             Nécessaire pour io.netty.channel.ChannelDuplexHandler/ChannelHandlerContext utilisés
             par EcoDisplayGuardListener. -->
        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-transport</artifactId>
            <version>4.2.15.Final</version>
            <scope>provided</scope>
        </dependency>

        <!-- Bundled by Paper at runtime (server/libraries/com/google/code/gson) — used to
             parse pending_commands responses from the mineweb API. -->
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>2.14.0</version>
            <scope>provided</scope>
        </dependency>

        <!-- ProtocolLib (soft dependency, provided at runtime).
             Compiled against the actual plugin jar installed on the SemiRP server (running a
             5.5.0-SNAPSHOT build not published under a resolvable version on dmulloy2's repo)
             — same systemPath technique already used by plugins/InfluOffrande/pom.xml for
             ItemsAdder. -->
        <dependency>
            <groupId>com.comphenix.protocol</groupId>
            <artifactId>ProtocolLib</artifactId>
            <version>5.5.0-local</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/../../serveurs/03_semirp/plugins/ProtocolLib.jar</systemPath>
        </dependency>

        <!-- EcoJobs (soft dependency, provided at runtime) — utilisé pour écouter
             PlayerJobExpGainEvent (boss bar de progression d'XP de métier). Même technique
             systemPath que ProtocolLib ci-dessus : pas de repo Maven public. -->
        <dependency>
            <groupId>com.willfp</groupId>
            <artifactId>ecojobs</artifactId>
            <version>2026.38-local</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/../../serveurs/03_semirp/plugins/EcoJobs-2026.38-spigot.jar</systemPath>
        </dependency>

        <!-- eco (framework partagé Auxilor, dépendance obligatoire d'EcoJobs) — nécessaire
             en plus du jar EcoJobs ci-dessus car com.willfp.ecojobs.jobs.Job implémente
             com.willfp.eco.core.registry.Registrable, défini dans ce jar. -->
        <dependency>
            <groupId>com.willfp</groupId>
            <artifactId>eco</artifactId>
            <version>2026.38-local</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/../../serveurs/03_semirp/plugins/eco-2026.41-modrinth.jar</systemPath>
        </dependency>

        <!-- Vault (soft dependency, provided at runtime) — utilisé pour net.milkbowl.vault.economy.Economy,
             cf. LateVaultEconomyBinder (contourne un race condition de démarrage où eco/EcoJobs
             enregistre son intégration économie AVANT que CMIEInjector n'ait fini de hooker
             CMIEconomy dans Vault, cf. CLAUDE.md). Pas de repo Maven public, même technique
             systemPath. -->
        <dependency>
            <groupId>com.github.MilkBowl</groupId>
            <artifactId>VaultAPI</artifactId>
            <version>2.20.3-local</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/../../serveurs/03_semirp/plugins/VaultUnlocked-2.20.3.jar</systemPath>
        </dependency>

        <!-- CustomFishing (soft dependency, provided at runtime) — utilisé par RepairMenu
             pour réparer les cannes du plugin : leur durabilité vit dans le NBT custom_data
             (compound "CustomFishing", clés max_dur/cur_dur), hors de portée de Bukkit, et
             seule l'API ItemManager la réécrit correctement. Pas de repo Maven public, même
             technique systemPath que les autres. -->
        <dependency>
            <groupId>net.momirealms</groupId>
            <artifactId>customfishing</artifactId>
            <version>2.3.27-local</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/../../serveurs/03_semirp/plugins/CustomFishing-2.3.28.jar</systemPath>
        </dependency>

        <!-- CMI (soft dependency, provided at runtime) — utilisé pour écouter
             com.Zrips.CMI.events.CMIUserBalanceChangeEvent (action bar de gain d'argent
             cumulatif, remplace l'ancien hook EssentialsX depuis la migration EssentialsX→CMI,
             cf. MoneyGainActionBarListener et CLAUDE.md). Pas de repo Maven public, même
             technique systemPath. -->
        <dependency>
            <groupId>com.Zrips</groupId>
            <artifactId>cmi</artifactId>
            <version>9.8.10.0-local</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/../../serveurs/03_semirp/plugins/CMI-9.8.11.0.jar</systemPath>
        </dependency>
    </dependencies>

    <profiles>
        <!-- Compilation contre l'API Paper 26.3 (migration de decembre 2026) pour verifier que
             le plugin reste compatible : mvn -P paper-26.3. Le jar de prod reste compile en 26.2. -->
        <profile>
            <id>paper-26.3</id>
            <properties>
                <paper.api.version>26.3.build.200-stable</paper.api.version>
            </properties>
        </profile>
    </profiles>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <source>${java.version}</source>
                    <target>${java.version}</target>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.3.0</version>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>fr.influencraft.influbridge.InfluBridgePlugin</mainClass>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
            <!-- Copie automatique du jar vers le serveur SemiRP après chaque build.
                 Ne redémarre pas le serveur — le plugin ne sera chargé qu'au prochain restart. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>deploy-to-semirp</id>
                        <phase>package</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <copy file="${project.build.directory}/${project.artifactId}-${project.version}.jar"
                                      tofile="${project.basedir}/../../serveurs/03_semirp/plugins/${project.artifactId}.jar"
                                      overwrite="true"/>
                                <echo message="InfluBridge.jar copié vers serveurs/03_semirp/plugins/"/>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
