<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>fr.influencraft</groupId>
    <artifactId>FluxTools</artifactId>
    <version>0.1.0</version>
    <packaging>jar</packaging>

    <properties>
        <java.version>25</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <repositories>
        <repository>
            <id>papermc</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
        </repository>
    </repositories>

    <dependencies>
        <dependency>
            <groupId>io.papermc.paper</groupId>
            <artifactId>paper-api</artifactId>
            <version>26.2.build.124-stable</version>
            <scope>provided</scope>
        </dependency>

        <!-- Flux modules come from the reactor build; third-party server jars are copied into libs/ (see LIBS.md). -->
        <dependency>
            <groupId>fr.influencraft</groupId>
            <artifactId>Flux</artifactId>
            <version>0.1.0</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>net.milkbowl</groupId>
            <artifactId>vaultunlocked</artifactId>
            <version>2.20.3</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/libs/VaultUnlocked-2.20.3.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>me.clip</groupId>
            <artifactId>placeholderapi</artifactId>
            <version>2.12.3</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/libs/PlaceholderAPI-2.12.3.jar</systemPath>
        </dependency>
        <!-- Optional plugins used by the utility modules (ex-InfluBridge) -->
        <dependency>
            <groupId>com.willfp</groupId>
            <artifactId>eco</artifactId>
            <version>2026.41</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/libs/eco-2026.41-modrinth.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>com.willfp</groupId>
            <artifactId>ecojobs</artifactId>
            <version>2026.38</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/libs/EcoJobs-2026.38-spigot.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>com.comphenix.protocol</groupId>
            <artifactId>ProtocolLib</artifactId>
            <version>5.5.0</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/libs/ProtocolLib.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>com.zrips</groupId>
            <artifactId>cmi</artifactId>
            <version>9.8.11.0</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/libs/CMI-9.8.11.0.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>net.momirealms</groupId>
            <artifactId>customfishing</artifactId>
            <version>2.3.28</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/libs/CustomFishing-2.3.28.jar</systemPath>
        </dependency>
    </dependencies>

    <build>
        <finalName>${project.artifactId}</finalName>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>${java.version}</release>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
