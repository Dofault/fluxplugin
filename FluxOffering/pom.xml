<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>fr.influencraft</groupId>
    <artifactId>FluxOffering</artifactId>
    <version>26.2</version>
    <packaging>jar</packaging>

    <name>FluxOffering</name>

    <properties>
        <java.version>25</java.version>
        <!-- API Paper de compilation : 26.2 = version actuelle du serveur. Les plugins compiles
             contre 26.2 restent compatibles 26.3. Pour valider contre 26.3 : mvn -P paper-26.3 -->
        <paper.api.version>26.2.build.124-stable</paper.api.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <repositories>
        <repository>
            <id>papermc</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
        </repository>
        <repository>
            <id>placeholderapi</id>
            <url>https://repo.extendedclip.com/content/repositories/placeholderapi/</url>
        </repository>
        <repository>
            <id>spigot-vault-api</id>
            <url>https://ci.ender.zone/plugin/repository/everything/</url>
        </repository>
    </repositories>

    <dependencies>
        <!-- Paper API (provided by the server at runtime), version pilotee par paper.api.version. -->
        <dependency>
            <groupId>io.papermc.paper</groupId>
            <artifactId>paper-api</artifactId>
            <version>${paper.api.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- Vault (soft dependency, provided at runtime) — used to deposit BitBlock
             (server economy, backed by EssentialsXEco) into an offrande's money requirement. -->
        <dependency>
            <groupId>net.milkbowl.vault</groupId>
            <artifactId>VaultAPI</artifactId>
            <version>1.7</version>
            <scope>provided</scope>
        </dependency>

        <!-- PlaceholderAPI (soft dependency, provided at runtime) -->
        <dependency>
            <groupId>me.clip</groupId>
            <artifactId>placeholderapi</artifactId>
            <version>2.11.6</version>
            <scope>provided</scope>
        </dependency>

        <!-- Bundled by Paper at runtime; declared explicitly because it isn't always pulled
             in transitively from paper-api for compilation (used to strip chat input down
             to plain text in the editor's chat-based quantity prompt). -->
        <dependency>
            <groupId>net.kyori</groupId>
            <artifactId>adventure-text-serializer-plain</artifactId>
            <version>4.24.0</version>
            <scope>provided</scope>
        </dependency>

        <!-- ItemsAdder API (soft dependency, provided at runtime).
             Compiled against the actual plugin jar installed on the SemiRP server (no working
             jitpack build exists for the 4.0.x line at the time of writing) — same technique
             already used by plugins/mana-sync/pom.xml. -->
        <dependency>
            <groupId>dev.lone</groupId>
            <artifactId>ItemsAdder</artifactId>
            <version>4.0.18</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/libs/ItemsAdder_4.0.18.jar</systemPath>
        </dependency>
    </dependencies>

    <profiles>
        <!-- Compilation contre l'API Paper 26.3 (migration de decembre 2026) pour verifier que
             le plugin reste compatible. Le jar de prod reste compile en 26.2. -->
        <profile>
            <id>paper-26.3</id>
            <properties>
                <paper.api.version>26.3.build.200-stable</paper.api.version>
            </properties>
        </profile>
    </profiles>

    <build>
        <finalName>${project.artifactId}</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>${java.version}</release>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.3.0</version>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>fr.influencraft.fluxoffering.FluxOfferingPlugin</mainClass>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
