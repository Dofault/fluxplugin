    13618380u, 3485519808u, 4291611855u, 3436171212u, 3486306255u, 3486502095u, 3486305484u, 3436167372u, 3486306252u, 0u, 0u, 0u,
    3221225472u, 3486502095u, 3436167168u, 3439131855u, 3486317568u, 3436171215u, 3221278668u, 3486499023u, 3486502092u, 3435188175u, 3486502095u, 3436171212u,
    13615116u, 3435974592u, 13618383u, 0u, 0u, 0u, 4290772992u, 13618431u, 3489660864u, 839628u, 4241476860u, 3439329231u,
    3485466831u, 4294954944u, 3489451980u, 4290773199u, 4294954239u, 218103759u, 3221278656u, 4291624959u, 52479u, 0u, 0u, 0u,
    3436167168u, 3221278668u, 3234843855u, 4227858639u, 3486306252u, 3486305487u, 3234840576u, 3435974607u, 3486502095u, 3486502080u, 3486306252u, 3222064335u,
    3485466831u, 3486502092u, 12u, 0u, 0u, 0u, 3221278656u, 3486305487u, 3485519808u, 3439119552u, 3486499023u, 3436167168u,
    3486306252u, 3486305487u, 3436171200u, 3439120335u, 3486499023u, 3485466624u, 13618368u, 3439120320u, 0u, 0u, 0u, 3221225472u,
    4290773199u, 3234844671u, 3234840783u, 3486515151u, 13619136u, 3489660864u, 4291624956u, 3234844671u, 3439328463u, 3486502095u, 13619136u, 3234840576u,
    3221278671u, 13618383u, 0u, 0u, 0u, 3435134976u, 3435970560u, 3435187404u, 3435187392u, 3234647244u, 3221277900u, 3435973836u,
    3435973836u, 3435187404u, 3435973836u, 3234647232u, 52428u, 3435187392u, 3435135180u, 52416u, 0u, 0u, 0u, 0u,
    0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u,
    0u, 0u, 0u, 0u
);
const vec3 PALETTE[16] = vec3[](
    vec3(0.0000, 0.0000, 0.0000),
    vec3(0.9608, 0.7725, 0.2902),
    vec3(0.6902, 0.3137, 0.4902),
    vec3(0.6235, 0.1098, 0.5922),
    vec3(0.3216, 0.0980, 0.5882),
    vec3(0.3451, 0.0706, 0.5059),
    vec3(0.1294, 0.0549, 0.2667),
    vec3(0.1647, 0.0353, 0.3216),
    vec3(0.1059, 0.0431, 0.1922),
    vec3(0.1059, 0.0431, 0.1804),
    vec3(0.1059, 0.0431, 0.1765),
    vec3(0.0784, 0.0314, 0.2118),
    vec3(0.1059, 0.0431, 0.1804),
    vec3(1.0000, 0.8863, 0.4784),
    vec3(0.9608, 0.6471, 0.1412),
    vec3(0.8510, 0.7765, 1.0000)
);
const float BAR_GAP = 7.0;
const float BAR_W = 104.0;
const float BAR_H = 7.0;

const vec3 SKY_TOP = vec3(0.0706, 0.0314, 0.1412);
const vec3 SKY_BOTTOM = vec3(0.2039, 0.0627, 0.3294);
const vec3 GLOW = vec3(0.4784, 0.2039, 0.7686);
const vec3 RAY = vec3(0.7451, 0.4706, 1.0000);
const vec3 FRAME_DARK = vec3(0.1059, 0.0431, 0.1804);
const vec3 FRAME_LIGHT = vec3(0.6078, 0.3647, 0.8980);
const vec3 BAR_EMPTY = vec3(0.0863, 0.0392, 0.1569);
const vec3 FILL_TOP = vec3(1.0000, 0.8863, 0.4784);
const vec3 FILL_BOTTOM = vec3(0.9608, 0.6471, 0.1412);
const vec3 SPARK_A = vec3(1.0000, 0.8431, 0.3686);
const vec3 SPARK_B = vec3(1.0000, 0.4784, 0.8510);
const vec3 SPARK_C = vec3(0.7882, 0.6510, 1.0000);

float hash(vec2 p) {
    p = fract(p * vec2(123.34, 456.21));
    p += dot(p, p + 45.32);
    return fract(p.x * p.y);
}

// ordered dithering on the picture's pixel grid: soft gradients that still look like pixels
float bayer(vec2 g) {
    ivec2 i = ivec2(mod(g, 4.0));
    int m[16] = int[](0, 8, 2, 10, 12, 4, 14, 6, 3, 11, 1, 9, 15, 7, 13, 5);
    return (float(m[i.y * 4 + i.x]) + 0.5) / 16.0;
}

vec3 steps(vec3 c, vec2 g) {
    return floor(c * 24.0 + bayer(g)) / 24.0;
}

int artAt(ivec2 a) {
    if (a.x < 0 || a.y < 0 || a.x >= ART_W || a.y >= ART_H) return 0;
    int i = a.y * ART_W + a.x;
    return int((ART[i >> 3] >> uint((i & 7) * 4)) & 15u);
}

// a 4-pointed star of radius r (grid pixels) around the centre
float star(vec2 d, float r) {
    vec2 a = abs(d);
    if (a.x < 0.5 && a.y < r + 0.5) return 1.0 - a.y / (r + 1.0);
    if (a.y < 0.5 && a.x < r + 0.5) return 1.0 - a.x / (r + 1.0);
    if (r > 1.5 && a.x < 1.5 && a.y < 1.5) return 0.55;
    return 0.0;
}

vec3 screen(bool bar, float progress) {
    vec2 size = ScreenSize;
    vec2 q = vec2(gl_FragCoord.x, size.y - gl_FragCoord.y);
    float t = GameTime * 1200.0;

    float blockH = float(ART_H) + BAR_GAP + BAR_H;
    float s = max(1.0, floor(min(size.x * 0.6 / float(ART_W), size.y * 0.62 / blockH)));
    vec2 origin = floor((size - vec2(float(ART_W), blockH) * s) * 0.5);
    vec2 g = floor((q - origin) / s);
    vec2 gs = (q - origin) / s;

    // background: night sky, glow and slow rays behind the logo
    vec2 centre = vec2(float(ART_W) * 0.5, 36.0);
    float sky = clamp(q.y / size.y, 0.0, 1.0);
    vec3 col = mix(SKY_TOP, SKY_BOTTOM, sky);
    vec2 d = g + 0.5 - centre;
    float dist = length(d) / (min(size.x, size.y) / s);
    col = mix(col, GLOW, 0.55 * exp(-dist * dist * 9.0));
    float angle = atan(d.y, d.x) / 6.2831853;
    float rays = step(0.5, fract(angle * 14.0 + t * 0.015));
    col = mix(col, RAY, rays * 0.10 * exp(-dist * 3.5));
    col = steps(col, g);

    // sparkles rising in columns
    const float CELL = 22.0;
    vec2 rise = gs + vec2(0.0, t * 6.0);
    for (int ox = -1; ox <= 1; ox++) {
        for (int oy = -1; oy <= 1; oy++) {
            vec2 c = floor(rise / CELL) + vec2(ox, oy);
            float h = hash(c);
            if (h > 0.42) continue;
            vec2 at = (c + vec2(hash(c + 3.1), hash(c + 7.7)) * 0.8 + 0.1) * CELL;
            at.x += floor(sin(t * 0.8 + h * 40.0) * 2.0);
            vec2 rel = floor(rise) - floor(at);
            float r = h < 0.12 ? 2.0 : 1.0;
            float twinkle = 0.55 + 0.45 * sin(t * 3.0 + h * 90.0);
            float v = star(rel, r) * twinkle;
            if (v <= 0.0) continue;
            vec3 sc = h < 0.14 ? SPARK_A : (h < 0.28 ? SPARK_B : SPARK_C);
            col = mix(col, sc, v);
        }
    }

    // the picture
    int idx = artAt(ivec2(g));
    if (idx > 0) col = PALETTE[idx];

    // our bar, under the picture
    if (bar) {
        vec2 b = g - vec2(floor((float(ART_W) - BAR_W) * 0.5), float(ART_H) + BAR_GAP);
        if (b.x >= 0.0 && b.y >= 0.0 && b.x < BAR_W && b.y < BAR_H) {
            bool outer = b.x < 1.0 || b.y < 1.0 || b.x >= BAR_W - 1.0 || b.y >= BAR_H - 1.0;
            bool corner = (b.x < 1.0 || b.x >= BAR_W - 1.0) && (b.y < 1.0 || b.y >= BAR_H - 1.0);
            bool inner = b.x < 2.0 || b.y < 2.0 || b.x >= BAR_W - 2.0 || b.y >= BAR_H - 2.0;
            if (corner) {
                // rounded corner: keep the background
            } else if (outer) {
                col = FRAME_DARK;
            } else if (inner) {
                col = FRAME_LIGHT;
            } else {
                float inside = BAR_W - 4.0;
                float filled = floor(inside * progress + 0.5);
                float x = b.x - 2.0;
                if (x < filled) {
                    float y = (b.y - 2.0) / (BAR_H - 5.0);
                    col = mix(FILL_TOP, FILL_BOTTOM, y);
                    float stripe = mod(x - (b.y - 2.0) - floor(t * 8.0), 8.0);
                    if (stripe < 3.0) col = mix(col, vec3(1.0, 0.97, 0.85), 0.28);
                    if (b.y < 3.0) col = mix(col, vec3(1.0), 0.35);
                    if (x == filled - 1.0) col = mix(col, vec3(1.0), 0.5);
                } else {
                    col = BAR_EMPTY;
                }
            }
        }
    }
    return col;
}

void main() {
    if (fluxLoading == 1) {
        float k = fluxProgress.y;
        float progress = k > 1e-4 ? fluxProgress.x / k : 0.0;
        fragColor = vec4(screen(true, progress), 1.0) * ColorModulator;
        return;
    }
    if (fluxLoading == 2) {
        fragColor = vec4(screen(false, 0.0), vertexColor.a) * ColorModulator;
        return;
    }
    vec4 color = vertexColor;
    if (color.a == 0.0) {
        discard;
    }
    fragColor = color * ColorModulator;
}
