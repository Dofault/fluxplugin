<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.influencraft.vaultsupermarket</groupId>
  <artifactId>VaultSuperMarket</artifactId>
  <packaging>jar</packaging>
  <version>26.2</version>
  <name>VaultSuperMarket</name>
  <url>http://maven.apache.org</url>

    <repositories>
    <repository>
      <id>papermc</id>
      <url>https://repo.papermc.io/repository/maven-public/</url>
    </repository>
        <repository>
        <id>spigot-vault-api</id>
        <url>https://ci.ender.zone/plugin/repository/everything/</url>
    </repository>
    <repository>
        <id>placeholderapi</id>
        <url>https://repo.extendedclip.com/content/repositories/placeholderapi/</url>
    </repository>
    <repository>
        <id>luckperms</id>
        <url>https://repo.lucko.me/</url>
    </repository>
  </repositories>

  <dependencies>
    <dependency>
      <groupId>junit</groupId>
      <artifactId>junit</artifactId>
      <version>3.8.1</version>
      <scope>test</scope>
    </dependency>



        <!-- Aligné sur la version réelle du serveur SemiRP (1.21.11) — migration 26.2. -->
        <dependency>
        <groupId>io.papermc.paper</groupId>
        <artifactId>paper-api</artifactId>
        <version>${paper.api.version}</version>
        <scope>provided</scope>
        </dependency>

    <dependency>
        <groupId>net.milkbowl.vault</groupId>
        <artifactId>VaultAPI</artifactId>
        <version>1.7</version>
    </dependency>
    <dependency>
        <groupId>me.clip</groupId>
        <artifactId>placeholderapi</artifactId>
        <version>2.11.6</version>
        <scope>provided</scope>
    </dependency>
    <dependency>
        <groupId>net.luckperms</groupId>
        <artifactId>api</artifactId>
        <version>5.4</version>
        <scope>provided</scope>
    </dependency>

    <!-- CustomFishing API (soft dependency, provided at runtime).
         Compiled against the actual plugin jar installed on the SemiRP server (no public
         Maven repo for MomiRealms plugins) — same technique already used by
         plugins/InfluOffrande/pom.xml and plugins/mana-sync/pom.xml for ItemsAdder. -->
    <dependency>
        <groupId>net.momirealms</groupId>
        <artifactId>customfishing</artifactId>
        <version>2.3.27</version>
        <scope>system</scope>
        <systemPath>${project.basedir}/libs/CustomFishing-2.3.28.jar</systemPath>
    </dependency>

    <!-- eco API (soft dependency, provided at runtime), même technique systemPath : nécessaire
         pour DropQueuePushEvent, par lequel passent les drops de la Télépathie d'EcoEnchants
         (cf. AutoSellEcoTelekinesisListener). -->
    <dependency>
        <groupId>com.willfp</groupId>
        <artifactId>eco</artifactId>
        <version>2026.38</version>
        <scope>system</scope>
        <systemPath>${project.basedir}/libs/eco-2026.41-modrinth.jar</systemPath>
    </dependency>

    <!-- ItemsAdder API (soft dependency, provided at runtime), même technique systemPath :
         nécessaire pour reconnaître un bloc ItemsAdder posé comme bloc magasin
         (CustomBlock.byAlreadyPlaced, cf. ItemsAdderHook). -->
    <dependency>
        <groupId>dev.lone</groupId>
        <artifactId>ItemsAdder</artifactId>
        <version>4.0.18</version>
        <scope>system</scope>
        <systemPath>${project.basedir}/libs/ItemsAdder_4.0.18.jar</systemPath>
    </dependency>

  </dependencies>


  <properties>
        <!-- API Paper de compilation : 26.2 = version du serveur. Les jars compiles contre 26.2
             restent compatibles 26.3 (mvn -P paper-26.3 pour le verifier) -->
        <paper.api.version>26.2.build.124-stable</paper.api.version>
      <maven.compiler.source>21</maven.compiler.source>
      <maven.compiler.target>21</maven.compiler.target>
  </properties>

    <profiles>
        <!-- Compilation contre l'API Paper 26.3 (migration de decembre 2026) pour verifier que
             le plugin reste compatible : mvn -P paper-26.3. Le jar de prod reste compile en 26.2. -->
        <profile>
            <id>paper-26.3</id>
            <properties>
                <paper.api.version>26.3.build.200-stable</paper.api.version>
            </properties>
        </profile>
    </profiles>

<build>

<!--
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <includes>
                    <include>plugin.yml</include>
                </includes>
            </resource>
        </resources>-->
        
    <plugins>
        <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-antrun-plugin</artifactId>
            <version>3.1.0</version>
            <executions>
                <execution>
                    <phase>package</phase>
                    <goals>
                        <goal>run</goal>
                    </goals>
                    <configuration>
                        <target>
                            <!-- Nom de fichier fixe (sans le numéro de version) pour éviter qu'un
                                 ancien jar versionné reste chargé en doublon à côté du nouveau.
                                 Copie sur les serveurs de test uniquement (Labs, Semi-Lab) : la
                                 prod SemiRP se met à jour à la main, après validation. -->
                            <copy file="${project.build.directory}/${project.build.finalName}.jar"
                                  tofile="${project.basedir}/../../../serveurs/04_labs/plugins/${project.artifactId}.jar"
                                  overwrite="true" />
                            <copy file="${project.build.directory}/${project.build.finalName}.jar"
                                  tofile="${project.basedir}/../../../serveurs/05_semilab/plugins/${project.artifactId}.jar"
                                  overwrite="true" />
                        </target>
                    </configuration>
                </execution>
            </executions>
        </plugin>
    </plugins>
</build>
</project>
